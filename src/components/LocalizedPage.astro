---
import Layout from '../layouts/Layout.astro';
import LocalizedCalculator from '../components/LocalizedCalculator.astro';
import FAQ from '../components/FAQ.astro';
import CalculatorLinks from '../components/CalculatorLinks.astro';
import { absoluteUrl, conversionRouteKeys, getPageContent, localizedPath, routePaths, type Locale, type RouteKey } from '../i18n';
import { buildExamples } from '../lib/examples';
import type { Course } from '../lib/swimming/events';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const content = getPageContent(locale, route);
const ui = getUi(locale);
const homeContent = getPageContent(locale, 'home');
const isConversion = conversionRouteKeys.includes(route);
const from = isConversion ? route.split('-to-')[0].toUpperCase() as Course : undefined;
const to = isConversion ? route.split('-to-')[1].toUpperCase() as Course : undefined;
const examples = from && to ? buildExamples(from, to, locale) : [];
const courseRows = homeContent.courses ?? [];
const relatedTools = (homeContent.tools ?? []).filter((tool) => tool.route !== route).slice(0, 7);
const jsonLd: Record<string, unknown>[] = [];

if (content.faqs?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: content.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}

if (route !== 'home') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: absoluteUrl(localizedPath(locale, 'home')) },
      { '@type': 'ListItem', position: 2, name: content.h1, item: absoluteUrl(localizedPath(locale, route)) },
    ],
  });
}

if (route === 'home' || isConversion || ['pace-calculator', 'split-calculator', 'css-calculator', 'interval-calculator', 'speed-calculator', 'calories-calculator', 'lengths-converter'].includes(route)) {
  jsonLd.unshift({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: content.h1,
    url: absoluteUrl(localizedPath(locale, route)),
    description: content.description,
    applicationCategory: 'SportsApplication',
    operatingSystem: 'Web',
    inLanguage: locale,
  });
}
---

<Layout
  title={content.title}
  description={content.description}
  locale={locale}
  route={route}
  canonical={absoluteUrl(localizedPath(locale, route))}
  jsonLd={jsonLd}
>
  {
    isConversion && (
      <section class="mx-auto w-full max-w-6xl px-4 pt-10 sm:px-6">
        <nav class="text-sm text-ink-subtle" aria-label={ui.breadcrumbLabel}>
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href={localizedPath(locale, 'home')} class="hover:text-ink">{ui.home}</a></li>
            <li aria-hidden="true" class="text-ink-tertiary">/</li>
            <li aria-current="page" class="text-ink-muted">{content.h1}</li>
          </ol>
        </nav>
      </section>
    )
  }

  <section class="mx-auto w-full max-w-3xl px-4 pb-10 pt-10 sm:px-6 sm:pt-12">
    {content.eyebrow && <p class="text-[13px] font-medium uppercase tracking-[0.08em] text-primary">{content.eyebrow}</p>}
    <h1 class:list={['text-3xl font-semibold tracking-tight text-ink sm:text-4xl', content.eyebrow && 'mt-3']}>{content.h1}</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-muted">{content.lead}</p>
  </section>

  {route === 'home' || isConversion || route !== 'about' && route !== 'contact' && route !== 'privacy-policy' && route !== 'terms' && route !== 'guides' ? (
    <section id="calculator" class="mx-auto w-full max-w-3xl scroll-mt-24 px-4 sm:px-6" aria-label={content.h1}>
      <LocalizedCalculator locale={locale} route={route} />
    </section>
  ) : null}

  {route === 'home' && relatedTools.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6" aria-label={ui.relatedCalculators}>
      <h2 class="text-center text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{ui.relatedCalculators}</h2>
      <div class="mx-auto mt-8 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {relatedTools.map((tool) => (
          <a href={localizedPath(locale, tool.route)} class="group rounded-xl border border-hairline bg-surface-1 p-6 transition-colors hover:border-hairline-strong hover:bg-surface-2">
            <h3 class="text-base font-semibold text-ink group-hover:underline">{tool.title}</h3>
            <p class="mt-1.5 text-sm text-ink-subtle">{tool.description}</p>
            <span class="mt-3 block text-sm font-medium text-primary group-hover:underline">{ui.openCalculator}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {route === 'guides' && relatedTools.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="grid gap-3 sm:grid-cols-2">
        {relatedTools.map((tool) => (
          <a href={localizedPath(locale, tool.route)} class="group rounded-xl border border-hairline bg-surface-1 p-5 shadow-sm transition-colors hover:border-hairline-strong">
            {tool.tag && <p class="text-xs font-medium uppercase tracking-wide text-primary">{tool.tag}</p>}
            <h2 class="mt-2 font-semibold text-ink group-hover:underline">{tool.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {courseRows.length > 0 && (
    <section class="border-y border-hairline bg-surface-1 py-14">
      <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{content.sections.find((item) => item.heading)?.heading ?? ui.course}</h2>
        <div class="mt-6 overflow-x-auto rounded-xl border border-hairline bg-canvas">
          <table class="w-full min-w-[420px] text-sm">
            <caption class="sr-only">{ui.course}</caption>
            <thead>
              <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-ink-muted">
                <th scope="col" class="px-4 py-3 font-medium">{ui.course}</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">{ui.length}</th>
                <th scope="col" class="px-4 py-3 font-medium">{ui.commonUsage}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {courseRows.map((course) => (
                <tr>
                  <th scope="row" class="px-4 py-3 text-left font-medium text-ink">
                    {course.code}
                    <span class="block text-xs font-normal text-ink-subtle">{course.name}</span>
                  </th>
                  <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-muted">{course.length}</td>
                  <td class="px-4 py-3 text-ink-subtle">{course.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {content.sections.map((item, index) => (
    <section class:list={['mx-auto w-full max-w-3xl px-4 py-10 sm:px-6', index % 2 === 1 && 'border-t border-hairline bg-surface-1']}>
      {item.heading && <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{item.heading}</h2>}
      <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        {item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {item.bullets && <ul class="list-disc space-y-2 pl-5">{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        {item.steps && <ol class="space-y-3">{item.steps.map((step, stepIndex) => <li class="flex gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-semibold text-primary">{stepIndex + 1}</span><span>{step}</span></li>)}</ol>}
      </div>
    </section>
  ))}

  {route === 'contact' && (
    <section class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
      <form action="mailto:hello@onlineswimtimeconverter.com" method="post" enctype="text/plain" class="space-y-5">
        <div>
          <label for="contact-subject" class="mb-1.5 block text-sm font-medium text-ink">{ui.contactSubject}</label>
          <select id="contact-subject" name="subject" class="w-full rounded-lg border border-hairline bg-surface-1 px-3 py-2.5 text-sm text-ink shadow-sm focus:outline-2 focus:outline-primary">
            <option>{ui.contactSubjectGeneral}</option>
            <option>{ui.contactSubjectCorrection}</option>
            <option>{ui.contactSubjectFeature}</option>
            <option>{ui.contactSubjectPartnership}</option>
          </select>
        </div>
        <div>
          <label for="contact-message" class="mb-1.5 block text-sm font-medium text-ink">{ui.contactMessage}</label>
          <textarea id="contact-message" name="body" rows="7" required placeholder={ui.contactMessagePlaceholder} class="w-full resize-y rounded-lg border border-hairline bg-surface-1 px-3 py-2.5 text-sm text-ink shadow-sm placeholder:text-ink-tertiary focus:outline-2 focus:outline-primary"></textarea>
        </div>
        <button type="submit" class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-hover active:bg-primary-focus">{ui.sendViaEmail}</button>
        <p class="text-xs text-ink-subtle">{ui.contactPrivacyNote}</p>
      </form>
    </section>
  )}

  {isConversion && (
    <section class="border-y border-hairline bg-surface-1 py-14">
      <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">{ui.exampleConversions.heading}</h2>
        <div class="mt-6 overflow-x-auto rounded-xl border border-hairline bg-canvas">
          <table class="w-full min-w-[380px] text-sm">
            <caption class="sr-only">{ui.exampleConversions.caption.replace('{from}', from ?? '').replace('{to}', to ?? '')}</caption>
            <thead>
              <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-ink-muted">
                <th scope="col" class="px-4 py-3 font-medium">{ui.eventsLabel}</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">{from}</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">{to}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {examples.map((example) => (
                <tr>
                  <th scope="row" class="px-4 py-3 font-medium text-ink">{example.label}</th>
                  <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-muted">{example.fromText}</td>
                  <td class="px-4 py-3 text-right font-mono tabular-nums text-ink">{example.toText}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-ink-tertiary">{ui.exampleConversions.note}</p>
      </div>
    </section>
  )}

  {content.faqs?.length && (
    <section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
      <FAQ items={content.faqs} title={ui.faqTitle} />
    </section>
  )}

  {route !== 'home' && route !== 'about' && route !== 'contact' && route !== 'privacy-policy' && route !== 'terms' && route !== 'guides' && <CalculatorLinks locale={locale} current={routePaths[route]} />}
</Layout>
