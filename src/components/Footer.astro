---
import {
  getUi,
  localeFromPath,
  routeKeyFromPath,
  type Locale,
  type RouteKey,
} from '../i18n';
import {
  getCalculatorLinks,
  getCompanyLinks,
  getConverterLinks,
  isNavActive,
  type NavLink,
} from '../lib/navigation';

interface Props {
  locale?: Locale;
  route?: RouteKey;
}

const { locale: requestedLocale, route: requestedRoute } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const locale = requestedLocale ?? localeFromPath(path);
const route = requestedRoute ?? routeKeyFromPath(path);
const ui = getUi(locale);
const converterLinks = getConverterLinks(locale);
const calculatorLinks = getCalculatorLinks(locale);
const company = getCompanyLinks(locale);
const year = new Date().getFullYear();
const isActive = (link: NavLink) => route === link.route || isNavActive(path, link.href, locale);
---

<footer class="border-t border-hairline bg-surface-1">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a
          href={calculatorLinks[0].href}
          class="flex items-center gap-2.5 text-sm font-semibold text-ink"
          aria-current={route === 'home' ? 'page' : undefined}
        >
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-md bg-primary text-on-primary" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4">
              <path d="M4 6c2 0 2 1.5 4 1.5S10 6 12 6s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M4 10c2 0 2 1.5 4 1.5S10 10 12 10s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M4 14c2 0 2 1.5 4 1.5S10 14 12 14s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          {ui.calculatorLinks.home}
        </a>
        <p class="mt-3 max-w-[32ch] text-sm leading-relaxed text-ink-subtle">
          {ui.siteDescription}
        </p>
      </div>

      <nav aria-label={ui.conversions}>
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">{ui.conversions}</h3>
        <ul class="mt-3 space-y-2">
          {
            converterLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-subtle transition-colors hover:text-ink"
                  aria-current={isActive(link) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={ui.calculators}>
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">{ui.calculators}</h3>
        <ul class="mt-3 space-y-2">
          {
            calculatorLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-subtle transition-colors hover:text-ink"
                  aria-current={isActive(link) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={ui.company}>
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">{ui.company}</h3>
        <ul class="mt-3 space-y-2">
          {
            company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-subtle transition-colors hover:text-ink"
                  aria-current={isActive(link) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-hairline pt-6 text-xs text-ink-tertiary sm:flex-row sm:items-center sm:justify-between">
      <p>{ui.rightsReserved.replace('{year}', String(year))}</p>
      <p>{ui.estimatesDisclaimer}</p>
    </div>
  </div>
</footer>
