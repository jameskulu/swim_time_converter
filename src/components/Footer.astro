---
import { converterLinks, calculatorLinks } from '../lib/navigation';

const year = new Date().getFullYear();

const company = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms' },
];
---

<footer class="border-t border-hairline bg-surface-1">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 text-sm font-semibold text-ink">
          <span class="grid h-7 w-7 place-items-center rounded-md bg-primary text-on-primary" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4">
              <path d="M4 6c2 0 2 1.5 4 1.5S10 6 12 6s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M4 10c2 0 2 1.5 4 1.5S10 10 12 10s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M4 14c2 0 2 1.5 4 1.5S10 14 12 14s2 1.5 4 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          Swim Time Converter
        </a>
        <p class="mt-3 max-w-[32ch] text-sm leading-relaxed text-ink-subtle">
          Free browser-based tools for converting swimming times between SCY, SCM and LCM — plus pace, split, CSS and training calculators.
        </p>
      </div>

      <nav aria-label="Conversions">
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">Conversions</h3>
        <ul class="mt-3 space-y-2">
          {
            converterLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-subtle transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Calculators">
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">Calculators</h3>
        <ul class="mt-3 space-y-2">
          {
            calculatorLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-subtle transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted">Company</h3>
        <ul class="mt-3 space-y-2">
          {
            company.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-subtle transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-hairline pt-6 text-xs text-ink-tertiary sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Swim Time Converter. All rights reserved.</p>
      <p>All conversion results are estimates — not official times.</p>
    </div>
  </div>
</footer>