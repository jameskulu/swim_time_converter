---
import {
  conversionRouteKeys,
  getUi,
  localeFromPath,
  localizedPath,
  routeKeyFromPath,
  type Locale,
  type RouteKey,
} from '../i18n';
import {
  getConverterLinks,
  isNavActive,
  otherCalculators,
  otherConverters,
} from '../lib/navigation';

interface Props {
  locale?: Locale;
  route?: RouteKey;
  current?: string;
}

const { locale: requestedLocale, route: requestedRoute, current } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const locale = requestedLocale ?? localeFromPath(path);
const currentPath = current || path;
const route = requestedRoute ?? routeKeyFromPath(currentPath);
const currentIdentifier = route ?? currentPath;
const ui = getUi(locale);
const toolLinks = otherCalculators(currentIdentifier, locale);
const convLinks = route && conversionRouteKeys.includes(route)
  ? otherConverters(currentIdentifier, locale)
  : getConverterLinks(locale);
const paceCalculatorHref = localizedPath(locale, 'pace-calculator');
const guidesHref = localizedPath(locale, 'guides');
const isActive = (href: string, linkRoute?: RouteKey) =>
  (linkRoute !== undefined && route === linkRoute) || isNavActive(path, href, locale);
---

<div class="border-t border-hairline bg-surface-1 py-14">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <h2 class="text-lg font-semibold text-ink">{ui.moreSwimmingTools}</h2>
    <div class="mt-5 grid gap-6 lg:grid-cols-2">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.08em] text-ink-tertiary">{ui.calculators}</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            toolLinks.map((link) => {
              const active = isActive(link.href, link.route);
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'block rounded-lg border border-hairline bg-surface-1 px-3.5 py-2.5 text-sm transition-colors hover:border-hairline-strong hover:bg-surface-2',
                      active ? 'font-medium text-primary' : 'text-ink-muted hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.08em] text-ink-tertiary">{ui.courseConverters}</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            convLinks.map((link) => {
              const active = isActive(link.href, link.route);
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'block rounded-lg border border-hairline bg-surface-1 px-3.5 py-2.5 text-sm transition-colors hover:border-hairline-strong hover:bg-surface-2',
                      active ? 'font-medium text-primary' : 'text-ink-muted hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
    <p class="mt-6 text-sm text-ink-subtle">
      {ui.newHere.before}<a href={paceCalculatorHref} class="font-medium text-primary hover:underline">{ui.newHere.paceCalculator}</a>{ui.newHere.betweenLinks}<a href={guidesHref} class="font-medium text-primary hover:underline">{ui.newHere.courseConversionGuide}</a>{ui.newHere.after}
    </p>
  </div>
</div>
