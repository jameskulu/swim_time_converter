---
import Layout from '../../layouts/Layout.astro';
import LengthsConverter from '../../components/LengthsConverter';
import FAQ from '../../components/FAQ.astro';
import CalculatorLinks from '../../components/CalculatorLinks.astro';

const faqs = [
  {
    question: 'How do I convert 25 yards to meters?',
    answer:
      'Multiply yards by 0.9144: 25 yards × 0.9144 = 22.86 meters. That is the exact length of a short course yards (SCY) pool — about 2.14 meters (7 feet) shorter than a 25-meter pool. Use the calculator above to convert any custom yardage or meters instantly.',
  },
  {
    question: 'What is 1650 yards converted to meters?',
    answer:
      '1650 yards is equal to 1,508.76 meters (1650 × 0.9144). In American competitive swimming (SCY), the 1650-yard freestyle is known as the "pool mile," which closely corresponds to the international 1500-meter freestyle event.',
  },
  {
    question: 'How many lengths is 200m in a 25m pool?',
    answer:
      'A 200-meter swim is exactly 8 lengths in a 25-meter pool (or 4 lengths in a 50-meter Olympic pool). In a 25-yard pool, 200 meters equals roughly 218.72 yards, which is 8.75 lengths.',
  },
  {
    question: 'How many meters is a 500-yard swim?',
    answer:
      'A 500-yard swim is 457.2 meters (500 × 0.9144). In a 25-yard pool, this equals exactly 20 lengths. In a 25-meter pool, it takes approximately 18.28 lengths.',
  },
  {
    question: 'Why is 25 yards equal to 22.86 meters?',
    answer:
      'By international agreement, 1 yard is defined as exactly 0.9144 meters. Multiplying 25 yards by 0.9144 yields 22.86 meters. Because 25 meters is 27.34 yards, a 25-meter pool is roughly 9.1% longer than a 25-yard pool.',
  },
  {
    question: 'How many lengths is 5000m in a 25m pool?',
    answer:
      'A 5000-meter workout is exactly 200 lengths in a 25-meter pool (or 100 full laps down-and-back) and 100 lengths in a 50-meter Olympic pool.',
  },
  {
    question: 'How do I convert meters to yards?',
    answer:
      'Multiply meters by 1.09361: 100 meters × 1.09361 = 109.36 yards, and 1500 meters equals 1640.42 yards (just under the 1650-yard U.S. event).',
  },
  {
    question: 'What is 50 yards in meters?',
    answer:
      '50 yards is 45.72 meters (50 × 0.9144). Other standard event equivalents: 100 yd = 91.44 m, 200 yd = 182.88 m, 500 yd = 457.2 m, 1000 yd = 914.4 m, and 1650 yd = 1508.76 m.',
  },
  {
    question: 'How many miles is 64 lengths of a 25m pool?',
    answer:
      '64 lengths in a 25-meter pool equals 1,600 meters (64 × 25 m). Since 1 international statute mile is 1,609.34 meters, 64 lengths is roughly 0.994 miles — practically a full mile in the water.',
  },
  {
    question: 'What is the difference between a length and a lap?',
    answer:
      'A length is one single crossing of the pool from wall to wall (e.g. 25m in a 25m pool). A lap is traditionally two lengths (down and back to your starting wall). Most digital swim trackers allow you to log by either lengths or laps.',
  },
  {
    question: 'What is the difference between converting distance vs. converting swim times?',
    answer:
      'Distance conversion is fixed math (1 yard = 0.9144 meters). Swim time conversion is physiological: swimmers gain speed from wall push-offs and turns. Because a 25-yard pool has more turns than a 50-meter pool, you cannot simply multiply finish times by 0.9144. Use our dedicated Swim Time Converter to convert race and split times.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Swim Distance & Lengths Converter',
  url: 'https://onlineswimtimeconverter.com/lengths-converter/',
  applicationCategory: 'SportsApplication',
  operatingSystem: 'Web',
};
---

<Layout
  title="Swim Distance Converter: Yards to Meters & Pool Lengths"
  description="Convert swim distances instantly: 25 yd to 22.86 m, 500 yd, and 1650 yd to meters. Calculate exact pool lengths for 25y, 25m, and 50m pools with zero guesswork."
  jsonLd={[webAppLd, faqLd]}
>
  <section class="mx-auto w-full max-w-3xl px-4 pb-8 pt-10 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Swim Distance &amp; Lengths Converter</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-muted">
      Convert yards to meters or meters to yards for any swim distance, then see how many lengths that is in a 25-yard,
      25-meter, or 50-meter pool.
    </p>

    <!-- Disambiguation Intent Banner -->
    <div class="mt-6 flex flex-wrap items-center gap-2 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm text-ink-muted">
      <span class="font-semibold text-ink">Need to convert race times?</span>
      <span>
        To convert finish times with turn adjustments across SCY, SCM, and LCM, visit our
        <a href="/" class="font-medium text-primary hover:underline">Swim Time Converter</a> or
        <a href="/scy-to-lcm/" class="font-medium text-primary hover:underline">SCY to LCM Converter</a>.
      </span>
    </div>
  </section>

  <section id="calculator" class="mx-auto w-full max-w-3xl scroll-mt-24 px-4 sm:px-6">
    <LengthsConverter client:load />
  </section>

  <!-- High Opportunity Quick Answers Callout Cards -->
  <section class="mx-auto w-full max-w-3xl px-4 pt-10 sm:px-6">
    <h2 class="text-lg font-semibold tracking-tight text-ink">Popular Quick Distance Answers</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-hairline bg-surface-1 p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">The Swimmer's Mile</p>
        <p class="mt-1 text-lg font-bold text-ink">1650 Yd = 1,508.8 M</p>
        <p class="mt-1 text-xs text-ink-subtle">60.35 lengths in 25m pool (66 lengths in 25yd)</p>
      </div>
      <div class="rounded-xl border border-hairline bg-surface-1 p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Mid-Distance Benchmark</p>
        <p class="mt-1 text-lg font-bold text-ink">500 Yd = 457.2 M</p>
        <p class="mt-1 text-xs text-ink-subtle">20 lengths in 25yd pool (18.28 lengths in 25m)</p>
      </div>
      <div class="rounded-xl border border-hairline bg-surface-1 p-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">SCY Pool Length</p>
        <p class="mt-1 text-lg font-bold text-ink">25 Yd = 22.86 M</p>
        <p class="mt-1 text-xs text-ink-subtle">1 length (75 ft), 2.14m shorter than 25m</p>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">How to Use It</h2>
    <ol class="mt-5 space-y-4">
      <li class="flex gap-3">
        <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-primary/10 text-xs font-bold text-primary">1</span>
        <p class="text-[15px] leading-relaxed text-ink-muted">
          Choose <strong class="text-ink">Yards ↔ meters</strong> to convert a swim distance between units, or pick your
          <strong class="text-ink"> pool length</strong> (25 yd, 25 m or 50 m) to work in lengths.
        </p>
      </li>
      <li class="flex gap-3">
        <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-primary/10 text-xs font-bold text-primary">2</span>
        <p class="text-[15px] leading-relaxed text-ink-muted">
          Enter <strong class="text-ink">yards or meters</strong> — the other field updates instantly (25 yd → 22.86 m). Or choose
          <strong class="text-ink">distance → lengths</strong> to see how many lengths your target set takes.
        </p>
      </li>
      <li class="flex gap-3">
        <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-primary/10 text-xs font-bold text-primary">3</span>
        <p class="text-[15px] leading-relaxed text-ink-muted">
          Use the quick picks — 25 yd, 50 yd, 100 yd, 500 yd, 1000 yd, 1650 yd — or common distances like 200, 400, 1000
          and 1500.
        </p>
      </li>
      <li class="flex gap-3">
        <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md bg-primary/10 text-xs font-bold text-primary">4</span>
        <p class="text-[15px] leading-relaxed text-ink-muted">
          Read the <strong class="text-ink">full lengths</strong> with any partial remainder, or the equivalent distance in the other unit.
        </p>
      </li>
    </ol>
  </section>

  <!-- Complete Standard Distances Matrix Table -->
  <section class="border-y border-hairline bg-surface-1 py-14">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">Standard Swimming Distances &amp; Pool Lengths Chart</h2>
      <p class="mt-2 text-sm text-ink-subtle">
        Quick reference for common workout distances converted between yards and meters, plus exact length counts per pool size.
      </p>

      <div class="mt-6 overflow-x-auto rounded-xl border border-hairline bg-surface-2">
        <table class="w-full text-left text-sm text-ink-muted">
          <thead class="border-b border-hairline bg-surface-3/50 text-xs uppercase tracking-wider text-ink">
            <tr>
              <th scope="col" class="px-4 py-3">Event / Distance</th>
              <th scope="col" class="px-4 py-3">Yards</th>
              <th scope="col" class="px-4 py-3">Meters</th>
              <th scope="col" class="px-4 py-3">25y Pool</th>
              <th scope="col" class="px-4 py-3">25m Pool</th>
              <th scope="col" class="px-4 py-3">50m Pool</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">25 yd (SCY length)</td>
              <td class="px-4 py-2.5">25 yd</td>
              <td class="px-4 py-2.5 font-medium text-primary">22.86 m</td>
              <td class="px-4 py-2.5">1</td>
              <td class="px-4 py-2.5">0.91</td>
              <td class="px-4 py-2.5">0.46</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">50 yd (Sprint)</td>
              <td class="px-4 py-2.5">50 yd</td>
              <td class="px-4 py-2.5 font-medium text-primary">45.72 m</td>
              <td class="px-4 py-2.5">2</td>
              <td class="px-4 py-2.5">1.83</td>
              <td class="px-4 py-2.5">0.91</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">100 m</td>
              <td class="px-4 py-2.5 font-medium text-primary">109.36 yd</td>
              <td class="px-4 py-2.5">100 m</td>
              <td class="px-4 py-2.5">4.37</td>
              <td class="px-4 py-2.5">4</td>
              <td class="px-4 py-2.5">2</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">200 m</td>
              <td class="px-4 py-2.5 font-medium text-primary">218.72 yd</td>
              <td class="px-4 py-2.5">200 m</td>
              <td class="px-4 py-2.5">8.75</td>
              <td class="px-4 py-2.5 font-semibold text-ink">8 lengths</td>
              <td class="px-4 py-2.5 font-semibold text-ink">4 lengths</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">500 yd</td>
              <td class="px-4 py-2.5">500 yd</td>
              <td class="px-4 py-2.5 font-medium text-primary">457.20 m</td>
              <td class="px-4 py-2.5 font-semibold text-ink">20 lengths</td>
              <td class="px-4 py-2.5">18.28</td>
              <td class="px-4 py-2.5">9.14</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">1000 yd</td>
              <td class="px-4 py-2.5">1000 yd</td>
              <td class="px-4 py-2.5 font-medium text-primary">914.40 m</td>
              <td class="px-4 py-2.5 font-semibold text-ink">40 lengths</td>
              <td class="px-4 py-2.5">36.57</td>
              <td class="px-4 py-2.5">18.28</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">1500 m (Olympic Mile)</td>
              <td class="px-4 py-2.5 font-medium text-primary">1640.42 yd</td>
              <td class="px-4 py-2.5">1500 m</td>
              <td class="px-4 py-2.5">65.62</td>
              <td class="px-4 py-2.5 font-semibold text-ink">60 lengths</td>
              <td class="px-4 py-2.5 font-semibold text-ink">30 lengths</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">1650 yd (Pool Mile)</td>
              <td class="px-4 py-2.5">1650 yd</td>
              <td class="px-4 py-2.5 font-medium text-primary">1508.76 m</td>
              <td class="px-4 py-2.5 font-semibold text-ink">66 lengths</td>
              <td class="px-4 py-2.5">60.35</td>
              <td class="px-4 py-2.5">30.17</td>
            </tr>
            <tr class="hover:bg-surface-3/30">
              <td class="px-4 py-2.5 font-medium text-ink">5000 m (Endurance)</td>
              <td class="px-4 py-2.5 font-medium text-primary">5468.07 yd</td>
              <td class="px-4 py-2.5">5000 m</td>
              <td class="px-4 py-2.5">218.72</td>
              <td class="px-4 py-2.5 font-semibold text-ink">200 lengths</td>
              <td class="px-4 py-2.5 font-semibold text-ink">100 lengths</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pool Dimension Comparison -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-hairline bg-surface-2 p-4">
          <h3 class="text-sm font-semibold text-ink">25-Yard Pool (SCY)</h3>
          <p class="mt-1 text-xs text-ink-subtle">Standard in US High School &amp; NCAA</p>
          <p class="mt-2 text-xs text-ink-muted"><strong>Length:</strong> 75 feet = 22.86 meters</p>
          <p class="text-xs text-ink-muted"><strong>Difference:</strong> 2.14 m shorter than 25m</p>
        </div>
        <div class="rounded-xl border border-hairline bg-surface-2 p-4">
          <h3 class="text-sm font-semibold text-ink">25-Meter Pool (SCM)</h3>
          <p class="mt-1 text-xs text-ink-subtle">International Short Course Standard</p>
          <p class="mt-2 text-xs text-ink-muted"><strong>Length:</strong> 82.02 feet = 27.34 yards</p>
          <p class="text-xs text-ink-muted"><strong>Difference:</strong> 9.14% longer than 25 yards</p>
        </div>
        <div class="rounded-xl border border-hairline bg-surface-2 p-4">
          <h3 class="text-sm font-semibold text-ink">50-Meter Pool (LCM)</h3>
          <p class="mt-1 text-xs text-ink-subtle">Olympic &amp; World Championship Course</p>
          <p class="mt-2 text-xs text-ink-muted"><strong>Length:</strong> 164.04 feet = 54.68 yards</p>
          <p class="text-xs text-ink-muted"><strong>Difference:</strong> Exactly double a 25m pool</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Guidance -->
  <section class="border-t border-hairline bg-surface-1 py-16">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Why Use the Swim Distances &amp; Lengths Converter?</h2>
      <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        <p>
          Pool distances are the quiet trap in every training plan. A "mile" can be <strong class="font-semibold text-ink">1500
          meters, 1650 yards or an actual 1760 yards</strong> depending on the pool; and because 25 yards is 22.86 meters,
          a yards-to-meters conversion changes the length of every set you swim. This converter settles the yards-to-meters
          questions once and for all — instantly, both ways, with the exact numbers swimmers actually search for.
        </p>
      </div>

      <h3 class="mt-8 text-lg font-semibold tracking-tight text-ink">The yards to meters conversions swimmers actually search</h3>
      <div class="mt-3 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        <p>
          <strong class="font-semibold text-ink">25 yards to meters</strong> = 22.86 m,
          <strong class="font-semibold text-ink">25 meters to yards</strong> = 27.34 yd,
          <strong class="font-semibold text-ink">50 yards to meters</strong> = 45.72 m, and the
          <strong class="font-semibold text-ink">1650 yards to meters</strong> conversion is 1508.76 m.
          Whether you search with U.S. yardage or international metric courses, you get instant math without rounding errors.
        </p>
      </div>

      <h3 class="mt-8 text-lg font-semibold tracking-tight text-ink">From meters and yards to workout sets you can swim</h3>
      <div class="mt-3 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        <p>
          Once you know the exact physical distance, you need to know how many times you will touch the wall. The distance-to-lengths mode answers
          "how many lengths is 200m, 500yd or 5000m?" in any course. Then pair your yardage with the
          <a href="/interval-calculator/" class="font-medium text-primary hover:underline">Interval Calculator</a> to build customized training sets or the
          <a href="/pace-calculator/" class="font-medium text-primary hover:underline">Pace Calculator</a> to calculate your per-100 target pace.
        </p>
      </div>

      <h3 class="mt-8 text-lg font-semibold tracking-tight text-ink">Distance vs. Time: Why Race Times Need a Different Formula</h3>
      <div class="mt-3 space-y-4 text-[15px] leading-relaxed text-ink-muted">
        <p>
          Remember that physical distance conversion is straightforward linear mathematics (1 yard = 0.9144 meters).
          However, when converting <em>swim times</em> between SCY, SCM, and LCM, turns make a dramatic difference. Swimmers travel faster off the push-off and glide than while swimming at surface speed, so courses with more walls (like 25-yard pools) yield faster times than long-course 50-meter pools.
          For event finish times, use our <a href="/" class="font-medium text-primary hover:underline">Swim Time Converter</a> or <a href="/scy-to-lcm/" class="font-medium text-primary hover:underline">SCY to LCM course converter</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
    <FAQ items={faqs} title="Lengths Converter FAQ" />
  </section>

  <CalculatorLinks current="/lengths-converter/" />
</Layout>
