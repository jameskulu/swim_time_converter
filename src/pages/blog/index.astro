---
import Layout from '../../layouts/Layout.astro';

const siteUrl = 'https://onlineswimtimeconverter.com';

const posts = [
  {
    href: '/blog/swimming-mile-explained/',
    title: "The Swimmer's Mile Explained: Laps, Lengths, Yards, and Meters",
    description:
      'Demystify the swimming mile: learn why 1650 yards and 1500 meters are called a mile, how many lengths to swim in 25y, 25m, and 50m pools, and the 64 lengths rule.',
    category: 'Distance & Pool Lengths · 7 min read',
    published: '2026-11-03',
    publishedLabel: 'November 3, 2026',
    cta: 'Read the guide',
  },
  {
    href: '/blog/triathlon-swim-distances-in-pool-laps/',
    title: 'Triathlon Swim Distances in Pool Laps: Sprint, Olympic, 70.3, and Ironman',
    description:
      'Convert triathlon swim distances to pool laps and lengths for Sprint (750m), Olympic (1500m), 70.3 Half Ironman (1.2 mi), and Full Ironman (2.4 mi).',
    category: 'Triathlon & Endurance · 6 min read',
    published: '2026-11-03',
    publishedLabel: 'November 3, 2026',
    cta: 'Read the guide',
  },
  {
    href: '/blog/swim-distance-vs-time-conversion/',
    title: "Distance vs. Time Conversion in Swimming: Why 0.9144 Doesn't Work for Times",
    description:
      'Learn why you cannot simply multiply swimming times by 0.9144 or 1.0936. Understand wall physics, turn factors, and how to convert SCY, SCM, and LCM times accurately.',
    category: 'Technical Swimming · 7 min read',
    published: '2026-11-03',
    publishedLabel: 'November 3, 2026',
    cta: 'Read the article',
  },
  {
    href: '/blog/swimswam-time-converter-alternative/',
    title: 'SwimSwam Time Converter Alternative: Fast, Modern SCY, SCM & LCM Tool',
    description:
      'Looking for a fast, ad-free SwimSwam swim time converter alternative? Compare SCY, SCM, and LCM times side-by-side with instant calculations on mobile and desktop.',
    category: 'Tools & Software · 5 min read',
    published: '2026-11-03',
    publishedLabel: 'November 3, 2026',
    cta: 'Read the comparison',
  },
  {
    href: '/blog/scy-vs-scm-vs-lcm/',
    title: 'SCY vs SCM vs LCM: Which Pool Course Is Faster?',
    description:
      'Compare the three competition courses: turn counts by event, why times shift between pools, the conversion factors involved, worked examples, and when a converted time is unreliable.',
    category: 'Swimming courses · 10 min read',
    published: '2026-10-27',
    publishedLabel: 'October 27, 2026',
    cta: 'Read the comparison',
  },
  {
    href: '/blog/how-to-calculate-swimming-pace/',
    title: 'How to Calculate Swimming Pace: Per 100m, 100yd, and Race Splits',
    description:
      'Learn the simple swim pace formula, work through examples in meters and yards, and turn a race goal into useful training splits. Includes tips for pool course differences and common calculation mistakes.',
    category: 'Training fundamentals · 8 min read',
    published: '2026-10-25',
    publishedLabel: 'October 25, 2026',
    cta: 'Read the guide',
  },
];

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Swim Time Converter Blog',
  url: `${siteUrl}/blog/`,
  description: 'Practical swimming guides for pace, race splits, pool courses, and smarter training.',
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${siteUrl}${post.href}`,
    datePublished: post.published,
  })),
};
---

<Layout
  title="Swimming Blog: Pace, Splits & Training Guides | Swim Time Converter"
  description="Read practical swimming guides on calculating pace per 100, planning race splits, and understanding swim times in yards and meters."
  canonical={`${siteUrl}/blog/`}
  jsonLd={blogLd}
>
  <section class="mx-auto w-full max-w-4xl px-4 pb-10 pt-10 sm:px-6 sm:pt-14">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary">Swim Time Converter Blog</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Swimming guides for smarter training and faster racing
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">
      Clear, practical advice for swimmers who want to understand their pace, plan better splits, and make sense of times across pool courses.
    </p>
  </section>

  <section class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
    <h2 class="sr-only">Latest swimming articles</h2>
    <div class="space-y-8">
      {
        posts.map((post) => (
          <article class="overflow-hidden rounded-2xl border border-hairline bg-surface-1 shadow-sm">
            <div class="border-b border-hairline bg-primary/5 px-6 py-5 sm:px-8">
              <p class="text-xs font-semibold uppercase tracking-wide text-primary">{post.category}</p>
              <p class="mt-2 text-sm text-ink-subtle">
                <time datetime={post.published}>{post.publishedLabel}</time>
              </p>
            </div>
            <div class="p-6 sm:p-8">
              <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                <a class="hover:text-primary" href={post.href}>
                  {post.title}
                </a>
              </h2>
              <p class="mt-4 max-w-3xl leading-relaxed text-ink-muted">{post.description}</p>
              <a
                class="mt-6 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary transition-colors hover:bg-primary-hover"
                href={post.href}
              >
                {post.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
