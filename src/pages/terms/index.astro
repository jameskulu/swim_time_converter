---
import Layout from '../../layouts/Layout.astro';

const sections = [
  {
    title: 'Acceptance of terms',
    body: 'By accessing or using Swim Time Converter you agree to these terms. If you do not agree, please do not use the site.',
  },
  {
    title: 'Nature of the service',
    body: 'This site provides free browser-based tools for estimating equivalent swimming times, paces and splits. The tools are provided "as is" and "as available", without warranties of any kind, express or implied.',
  },
  {
    title: 'No official sports advice',
    body: 'Converted times, paces and splits are estimates only. They are not official, certified, or sanctioned times. Always follow the rules of the governing body that issues or accepts times you submit to competition, and do not rely on this site for official qualification decisions.',
  },
  {
    title: 'Limitation of liability',
    body: 'To the fullest extent permitted by law, we shall not be liable for any direct, indirect, incidental, consequential or special damages arising from use of or inability to use the site, even if advised of the possibility of such damages. This includes errors in conversion results, availability of the site, or reliance on any content.',
  },
  {
    title: 'Intellectual property',
    body: 'The site design, text and functionality are owned by us or licensed to us. You may use the tools and share results, but you may not reproduce the site or its content for commercial purposes without permission.',
  },
  {
    title: 'Acceptable use',
    body: 'Do not misuse the site — for example by attempting to disrupt it, scrape it at scale, probe its infrastructure, or use it for unlawful purposes. We may restrict access that violates these terms.',
  },
  {
    title: 'Third-party links',
    body: 'The site may link to third-party websites for reference. We are not responsible for the content or practices of those sites and do not endorse them.',
  },
  {
    title: 'Changes to these terms',
    body: 'We may revise these terms at any time. Updated terms take effect when posted on this page. Continued use after changes constitutes acceptance.',
  },
  {
    title: 'Governing law',
    body: 'These terms are governed by applicable law, and any disputes are subject to the exclusive jurisdiction of the relevant courts. If any provision is found unenforceable, the rest remains in effect.',
  },
];
---

<Layout
  title="Terms of Service – Swim Time Converter"
  description="The Swim Time Converter terms of service: free browser-based tools, estimates only, and no liability for converted times."
>
  <section class="mx-auto w-full max-w-3xl px-4 pb-10 pt-10 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Terms of Service</h1>
    <p class="mt-4 text-base leading-relaxed text-ink-muted">
      Effective: January 2026. These terms govern your use of onlineswimtimeconverter.com.
    </p>
  </section>

  <section class="mx-auto w-full max-w-3xl space-y-8 px-4 pb-16 sm:px-6">
    {sections.map((s, i) => (
      <div class="space-y-2">
        <h2 class="flex items-center gap-3 text-lg font-semibold text-ink">
          <span class="text-sm font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
          {s.title}
        </h2>
        <p class="text-[15px] leading-relaxed text-ink-muted">{s.body}</p>
      </div>
    ))}
    <p class="pt-2 text-sm text-ink-subtle">
      Questions about these terms? Contact us at{' '}
      <a href="mailto:hello@onlineswimtimeconverter.com" class="font-medium text-primary hover:underline">
        hello@onlineswimtimeconverter.com
      </a>.
    </p>
    <p class="border-t border-hairline pt-6 text-sm text-ink-subtle">
      See the tools this site covers: <a href="/" class="font-medium text-primary hover:underline">Time Converter</a> ·
      <a href="/split-calculator/" class="font-medium text-primary hover:underline">Splits</a> ·
      <a href="/interval-calculator/" class="font-medium text-primary hover:underline">Send-offs</a> ·
      <a href="/calories-calculator/" class="font-medium text-primary hover:underline">Calories</a>
    </p>
  </section>
</Layout>