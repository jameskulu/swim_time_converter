---
import Layout from '../layouts/Layout.astro';

const navTargets = [
  { href: '/', label: 'Home' },
  { href: '/pace-calculator/', label: 'Pace Calculator' },
  { href: '/split-calculator/', label: 'Split Calculator' },
  { href: '/scy-to-scm/', label: 'SCY to SCM Converter' },
  { href: '/guides/', label: 'Guides' },
];
---

<Layout
  title="500 – Server Error – Swim Time Converter"
  description="Something went wrong on our end. Try again shortly or head back to the Swim Time Converter."
  noindex
>
  <section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
    <p class="font-mono text-7xl font-semibold tracking-tight text-primary sm:text-8xl" aria-hidden="true">500</p>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight text-ink">Something went wrong</h1>
    <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-ink-muted">
      An unexpected error happened on our side while loading this page. Give it a quick refresh — most hiccups clear
      themselves — then carry on with your swim planning.
    </p>

    <div class="mt-8 grid w-full max-w-xl grid-cols-1 gap-2 sm:grid-cols-2">
      {
        navTargets.map((link) => (
          <a
            href={link.href}
            class="rounded-lg border border-hairline bg-surface-1 px-4 py-3 text-sm font-medium text-ink-muted transition-colors hover:border-hairline-strong hover:bg-surface-2 hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-ink-subtle">
      Still seeing this after a refresh? <a href="/contact/" class="font-medium text-primary hover:underline">Let us know</a> what you were doing.
    </p>
  </section>
</Layout>